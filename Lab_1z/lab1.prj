##Data Import Section

read_file -type sourcelist filelist.f
#BackRefFile:/home/student/Documents/kdz/ASIC/Lab_1z/lab1.prj #LineNumber:13
read_file -type sgdc RTL/s7.sgdc

##Common Options Section

set_option projectwdir .
set_option language_mode mixed
set_option designread_enable_synthesis no
set_option designread_disable_flatten no
set_option active_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff
set_option top s7_stopwatch
set_option enableSV no


##Goal Setup Section

current_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


current_goal lint/lint_rtl -top s7_display
set_goal_option ignorerules { ReEntrantOutput-ML }
set_goal_option ignorerules { W154 }
set_goal_option ignorerules { IntReset }
set_goal_option ignorerules { IntClock }
set_goal_option ignorerules { UseBusWidth-ML }
set_goal_option addrules { IntRange-ML MacroFileName-ML FuncFileName-ML TaskFileName-ML SepTFMacro-ML CAPA-ML InlineComment-ML ModuleName-ML W146 ResetName ClkName ParamName FuncName }
set_goal_option ignorerules { AsgnNextSt-ML }
set_goal_option addrules { OnePortLine }
set_goal_option addrules { NoTab }
set_goal_option addrules { RegOutName }

current_methodology $SPYGLASS_HOME/GuideWare/2023.12/block/initial_rtl


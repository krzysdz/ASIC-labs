   + PROPERTY ACCESS_DIRECTION "0 left" ;
 - PIN out_data_source_id[1]
   + PROPERTY ACCESS_DIRECTION "0 left" ;
 - PIN out_data_source_id[0]
   + PROPERTY ACCESS_DIRECTION "0 left" ;
 - PIN out_data_last
   + PROPERTY ACCESS_DIRECTION "0 left" ;
 - PIN VDD
   + PROPERTY ACCESS_DIRECTION "0 top" ;
 - PIN VSS
   + PROPERTY ACCESS_DIRECTION "0 top" ;
END PINPROPERTIES
END DESIGN
